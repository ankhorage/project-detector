{
  "name": "@ankhorage/project-detector",
  "version": "0.3.0",
  "type": "module",
  "description": "Extensible, evidence-based project detection and safe filesystem inspection for standalone tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/project-detector.git"
  },
  "homepage": "https://github.com/ankhorage/project-detector#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/project-detector/issues"
  },
  "keywords": [
    "ankhorage",
    "cli",
    "package-manager",
    "polyglot",
    "project-detection",
    "typescript",
    "workspace"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "exports": {
    "./types": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/types/public.js"
    },
    ".": {
      "types": "./dist/projectDetector.d.ts",
      "import": "./dist/projectDetector.js"
    },
    "./node": {
      "types": "./dist/nodeProjectDetector.d.ts",
      "import": "./dist/nodeProjectDetector.js"
    },
    "./cli": {
      "types": "./dist/cli/createCliProvider.d.ts",
      "import": "./dist/cli/createCliProvider.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "project-detector": "./dist/cli/runAsync.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@ankhorage/ankh": "^0.8.13"
  },
  "peerDependenciesMeta": {
    "@ankhorage/ankh": {
      "optional": true
    }
  },
  "ankh": {
    "category": "project-detector",
    "provider": "./dist/cli/provider.js",
    "capabilities": [
      "project-detector.inspect"
    ]
  },
  "ankhorage": {
    "renovateSyncProtocol": 1
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test src",
    "docs": "paradox",
    "changeset": "ankhorage-changeset",
    "prepack": "bun run build",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version"
  },
  "dependencies": {
    "@ankhorage/utility": "^0.8.0",
    "minimatch": "^10.2.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.8.13",
    "@ankhorage/devtools": "^1.14.7",
    "@ankhorage/paradox": "^0.1.26",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.5.1",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
