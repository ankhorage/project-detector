{
  "name": "@ankhorage/project-detector",
  "version": "0.3.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/project-detector.git"
  },
  "dependencies": {
    "minimatch": "^10.2.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.13.7",
    "@ankhorage/capability": "^0.2.3",
    "@ankhorage/contracts": "^26.17.1",
    "@ankhorage/devtools": "^2.12.2",
    "@ankhorage/paradox": "^0.6.1",
    "@ankhorage/utility": "^1.11.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.11",
    "typescript": "~6.0.3"
  },
  "exports": {
    "./types": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/types/public.js"
    },
    ".": {
      "types": "./dist/projectDetector.d.ts",
      "import": "./dist/projectDetector.js"
    },
    "./node": {
      "types": "./dist/nodeProjectDetector.d.ts",
      "import": "./dist/nodeProjectDetector.js"
    },
    "./cli": {
      "types": "./dist/cli/createCliProvider.d.ts",
      "import": "./dist/cli/createCliProvider.js"
    },
    "./package.json": "./package.json",
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    }
  },
  "ankh": {
    "category": "project-detector",
    "provider": "./dist/cli/provider.js",
    "capabilities": [
      {
        "id": "project-detector.inspect",
        "owner": "@ankhorage/project-detector",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Inspect project",
        "description": "Inspect project languages, packages and workspaces without executing project code."
      }
    ]
  },
  "ankhorage": {
    "renovateSyncProtocol": 1
  },
  "bin": {
    "project-detector": "./dist/cli/runAsync.js"
  },
  "bugs": {
    "url": "https://github.com/ankhorage/project-detector/issues"
  },
  "description": "Extensible, evidence-based project detection and safe filesystem inspection for standalone tools.",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "homepage": "https://github.com/ankhorage/project-detector#readme",
  "keywords": [
    "ankhorage",
    "cli",
    "package-manager",
    "polyglot",
    "project-detection",
    "typescript",
    "workspace"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "peerDependenciesMeta": {
    "@ankhorage/ankh": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test src",
    "docs": "paradox",
    "changeset": "ankhorage-changeset",
    "prepack": "bun run build",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version"
  },
  "sideEffects": false,
  "type": "module"
}
